# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Нужен только для `npm run pull:*`. Команда `npm run build` работает без него.

# --- Google Sheets ---------------------------------------------------------
# Таблица должна быть расшарена «всем, у кого есть ссылка» (роль «Читатель»).
# Ключ: console.cloud.google.com → APIs & Services → Credentials → API key,
# затем включить Google Sheets API. Ключ желательно ограничить этим же API.
GOOGLE_SHEETS_API_KEY=

# Перебивает spreadsheetId из sheets/sheets.config.json (удобно для черновой копии).
# GOOGLE_SPREADSHEET_ID=

# --- API сайта переводов ---------------------------------------------------
# fixture — читать локальную выгрузку из fixtures/api (режим по умолчанию,
#           пока настоящего API нет);
# http    — ходить в реальный API.
PF2E_RU_API_MODE=fixture

# Нужны только при PF2E_RU_API_MODE=http
PF2E_RU_API_BASE_URL=
PF2E_RU_API_TOKEN=
